{
	"name": "synclab",
	"version": "0.1.1",
	"description": "Review your changes and sync your vault with a GitLab repository in one press.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc --noEmit && svelte-check --tsconfig ./tsconfig.json --threshold error --fail-on-warnings && node esbuild.config.mjs production",
		"lint": "eslint .",
		"test": "vitest run",
		"preview": "node scripts/preview.mjs",
		"test:contract": "vitest run --config vitest.contract.config.ts",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"install-plugin": "node scripts/install-plugin.mjs"
	},
	"keywords": [
		"obsidian",
		"gitlab",
		"sync"
	],
	"license": "MIT",
	"dependencies": {
		"diff": "^9.0.0",
		"ignore": "^7.0.12",
		"svelte": "^5.57.1"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@eslint/json": "^0.14.0",
		"@fontsource-variable/lexend": "^5.3.0",
		"@types/node": "^24.19.1",
		"esbuild": "^0.28.2",
		"esbuild-svelte": "^0.9.5",
		"eslint": "^9.39.5",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"fast-check": "^4.10.2",
		"globals": "^17.13.0",
		"obsidian": "^1.13.1",
		"svelte-check": "^4.7.6",
		"typescript": "~5.9.3",
		"typescript-eslint": "^8.71.0",
		"vite": "^8.3.2",
		"vitest": "^5.0.3"
	},
	"author": "Dip"
}
